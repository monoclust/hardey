{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hardey",
  "version": "0.2.0",
  "identifier": "com.techievo.hardey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "orb",
        "title": "HARDEY",
        "width": 58,
        "height": 58,
        "minWidth": 58,
        "minHeight": 58,
        "center": false,
        "x": 80,
        "y": 140,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "workspace",
        "title": "HARDEY \u2014 Personal AI Workspace",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8765; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Your personal AI desktop companion",
    "longDescription": "HARDEY is a local-first desktop companion for tasks, journaling and personal productivity.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
